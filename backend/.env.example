# PostgreSQL connection string (required for API, migrations, and seeds)
DATABASE_URL=postgresql://postgres:AbuBakr123@127.0.0.1:5432/airestaurants

# First-time server setup (optional overrides):
#   npm run db:migrate && npm run db:seed:admin && npm run db:seed
#   Or one shot: npm run db:setup
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=change-me-strong-password

PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs (for emails / tool hints)
PUBLIC_APP_URL=http://localhost:8080

# Optional: canonical HTTPS origin of this API (no trailing slash). Used for integration hints
# (ElevenLabs tool URLs, webhooks) in Restaurant settings when the browser origin differs from the API.
# PUBLIC_API_URL=https://airestaurant.toolkitpro.cloud

# Voice routing:
#   twilio_webhook     = Twilio → our inbound webhook → ElevenLabs (legacy default)
#   elevenlabs_native  = Twilio number imported in ElevenLabs only
#   synthflow_telnyx   = dedicated Telnyx number per restaurant + Synthflow inbound agent (recommended)
VOICE_ROUTING=synthflow_telnyx

# ElevenLabs + Twilio (legacy path — kept for existing restaurants)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# If several restaurants are active and the tool cannot resolve one, pin orders to this UUID (from dashboard URL /restaurants/{id})
# ELEVENLABS_DEFAULT_RESTAURANT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Telnyx (dedicated number per restaurant) ---
TELNYX_API_KEY=
# SIP Connection ID that routes to Synthflow (FQDN sip.synthflow.ai:32681). Required for inbound AI.
TELNYX_CONNECTION_ID=
# Credentials from the Telnyx SIP trunk (used when importing numbers into Synthflow)
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
# TELNYX_SIP_DOMAIN=sip.telnyx.com
# TELNYX_DEFAULT_COUNTRY=US

# --- Synthflow (AI agent per restaurant) ---
SYNTHFLOW_API_KEY=
SYNTHFLOW_WORKSPACE_ID=
# Synthflow HMAC webhook secret (Admin → Workspace Settings → Security → Webhooks).
# Server verifies HTTP_SYNTHFLOW_SIGNATURE = base64(HMAC-SHA256(call_id, secret)).
# SYNTHFLOW_WEBHOOK_SECRET=
# Prefer US or EU regional base if your workspace requires it:
# SYNTHFLOW_API_BASE=https://api.us.synthflow.ai/v2
# SYNTHFLOW_API_BASE_URL=https://api.us.synthflow.ai/v2

# Optional
RESEND_API_KEY=
OPENAI_API_KEY=
